# 默认行为：文本文件自动换行符转换
* text=auto

# 前端源码
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.vue text eol=lf

# 样式
*.css text eol=lf
*.scss text eol=lf
*.less text eol=lf

# 配置与文档
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
LICENSE text eol=lf
.env.example text eol=lf
.eslintrc.* text eol=lf
.prettierrc text eol=lf
.editorconfig text eol=lf

# HTML
*.html text eol=lf

# SVG (可视为文本)
*.svg text eol=lf

# 二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.tar binary
*.gz binary
